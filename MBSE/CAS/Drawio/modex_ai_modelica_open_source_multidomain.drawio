        <mxCell id="title" value="OPEN-SOURCE MODEX AI / MODELICA — ARQUITECTURA MULTIDOMINIO" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="55" as="geometry"/></mxCell><mxCell id="sub" value="Propuesta basada en jfxlcdp: MBSE + Spec-Driven Development + CAS + IA + simulación Modelica" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1320" height="35" as="geometry"/></mxCell><mxCell id="spec" value="1. ESPECIFICACIÓN / MBSE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1320" height="35" as="geometry"/></mxCell><mxCell id="spec0" value="Arcadia / Capella" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="50.0" y="175" width="320.0" height="50" as="geometry"/></mxCell><mxCell id="spec1" value="SysON / UML / SysML" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="380.0" y="175" width="320.0" height="50" as="geometry"/></mxCell><mxCell id="spec2" value="SRS + ADR + requisitos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="710.0" y="175" width="320.0" height="50" as="geometry"/></mxCell><mxCell id="spec3" value="Modelica architecture contracts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1040.0" y="175" width="320.0" height="50" as="geometry"/></mxCell><mxCell id="model" value="2